---
import BookTitleLink from "@/components/BookTitleLink.astro";
import { getBooks } from "@/lib/storage";
import { formatDisplayTime, formatEventDate } from "@/lib/format";
import type { EventRecord } from "@/lib/types";

interface Props {
  event: EventRecord | null;
}

const { event } = Astro.props;
const books = await getBooks();
---

<article class="event-summary card">
  <div class="eyebrow">Next Book Club Meeting</div>
  {
    event ? (
      <>
        <h2>{event.name}</h2>
        {event.bookTitle && <p class="linked-book">Book: <BookTitleLink title={event.bookTitle} books={books} /></p>}
        <p set:html={event.description} />
        <dl>
          <div>
            <dt>Date</dt>
            <dd>{formatEventDate(event.date)}</dd>
          </div>
          <div>
            <dt>Time</dt>
            <dd>
              {formatDisplayTime(event.startTime)}
              {event.endTime ? ` to ${formatDisplayTime(event.endTime)}` : ""}
            </dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{event.location}</dd>
          </div>
        </dl>
      </>
    ) : (
      <>
        <h2>No book club meeting scheduled yet</h2>
        <p>Add a `Book Club meeting` event below to highlight the next discussion night.</p>
      </>
    )
  }
</article>

<style>
  .event-summary {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 1.1rem;
    align-self: start;
  }

  .event-summary h2 {
    font-size: 2rem;
    margin-top: 0.15rem;
  }

  .linked-book {
    color: var(--accent-strong);
    font-weight: 700;
  }

  dl {
    display: grid;
    gap: 1rem;
    margin: 0;
    width: 100%;
  }

  dt {
    font-weight: 700;
    color: var(--ink);
  }

  dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
</style>
