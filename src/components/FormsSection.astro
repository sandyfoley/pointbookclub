---
import type { BookRecord, MemberRecord } from "@/lib/types";
import { EVENT_CATEGORIES } from "@/lib/types";

interface Props {
  books: BookRecord[];
  members: MemberRecord[];
}

const { books, members } = Astro.props;
const strippedBooks = books.map((book) => ({
  value: book.title,
  label: book.title.replace(/<[^>]+>/g, "").trim()
}));
const remoteEndpointBase = (import.meta.env.PUBLIC_FORM_ENDPOINT_BASE || "").replace(/\/$/, "");
const makeAction = (localPath: string) =>
  remoteEndpointBase ? `${remoteEndpointBase}/api/book-club-submit` : localPath;
---

<section class="section" id="forms">
  <div class="grid-two">
    <form class="card form-card" method="POST" action={makeAction("/api/book-club-submit")}>
      <input type="hidden" name="formType" value="event" />
      <input class="trap-field" type="text" name="companyName" tabindex="-1" autocomplete="off" />
      <div class="eyebrow">Add an event</div>
      <h2>Share a calendar event</h2>
      <div class="field-grid">
        <label>
          Event name
          <input name="name" required />
        </label>
        <label>
          Description
          <textarea name="description" required></textarea>
        </label>
        <label>
          Category
          <select name="category" required data-event-category>
            {EVENT_CATEGORIES.map((category) => <option value={category}>{category}</option>)}
          </select>
        </label>
        <label class="book-title-field" data-book-title-field hidden>
          Book title
          <select name="bookTitle">
            <option value="">Select a book title</option>
            {strippedBooks.map((book) => (
              <option value={book.value}>{book.label}</option>
            ))}
          </select>
        </label>
        <label class="host-member-field" data-host-member-field hidden>
          Host
          <select name="hostMemberId">
            <option value="">Select a host member</option>
            {members.map((member) => (
              <option value={member.id}>{member.name}</option>
            ))}
          </select>
        </label>
      </div>
      <div class="field-grid three">
        <label>
          Date
          <input type="date" name="date" required />
        </label>
        <label>
          Start time
          <input type="time" name="startTime" required />
        </label>
        <label>
          End time
          <input type="time" name="endTime" />
        </label>
      </div>
      <label>
        Location
        <input name="location" required />
      </label>
      <button class="button-primary" type="submit">Add event</button>
    </form>

    <form class="card form-card" method="POST" action={makeAction("/api/book-club-submit")}>
      <input type="hidden" name="formType" value="book" />
      <input class="trap-field" type="text" name="libraryName" tabindex="-1" autocomplete="off" />
      <div class="eyebrow">Book tracker</div>
      <h2>Add a book club title</h2>
      <div class="field-grid">
        <label>
          Title
          <input name="title" required />
        </label>
        <label>
          Member who picked the book
          <input name="pickedBy" required />
        </label>
        <label>
          Amazon URL
          <input type="url" name="amazonUrl" required />
        </label>
        <label>
          Book club month or date
          <input name="bookClubMonthOrDate" required />
        </label>
      </div>
      <label class="checkbox-row">
        <input type="checkbox" name="isCurrent" />
        Mark as the current selection
      </label>
      <button class="button-primary" type="submit">Add book</button>
    </form>
  </div>

  <div class="grid-two forms-lower">
    <form class="card form-card" method="POST" action={makeAction("/api/book-club-submit")}>
      <input type="hidden" name="formType" value="signup" />
      <input class="trap-field" type="text" name="clubHandle" tabindex="-1" autocomplete="off" />
      <div class="eyebrow">Membership</div>
      <h2>Join the club</h2>
      <div class="field-grid">
        <label>
          Your name
          <input name="memberName" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Notes
          <textarea name="notes"></textarea>
        </label>
      </div>
      <button class="button-primary" type="submit">Save interest</button>
    </form>

    <form class="card form-card" method="POST" action={makeAction("/api/book-club-submit")}>
      <input type="hidden" name="formType" value="invite" />
      <input class="trap-field" type="text" name="referralCode" tabindex="-1" autocomplete="off" />
      <div class="eyebrow">Invite a friend</div>
      <h2>Invite another member</h2>
      <div class="field-grid two">
        <label>
          Your name
          <input name="inviterName" required />
        </label>
        <label>
          Your email
          <input type="email" name="inviterEmail" required />
        </label>
        <label>
          Invitee name
          <input name="inviteeName" required />
        </label>
        <label>
          Invitee email
          <input type="email" name="inviteeEmail" required />
        </label>
      </div>
      <label>
        Message
        <textarea name="message"></textarea>
      </label>
      <button class="button-primary" type="submit">Save invite request</button>
    </form>
  </div>
</section>

<script>
  const categorySelect = document.querySelector("[data-event-category]");
  const bookTitleField = document.querySelector("[data-book-title-field]");
  const bookTitleSelect = bookTitleField?.querySelector("select");
  const hostMemberField = document.querySelector("[data-host-member-field]");
  const hostMemberSelect = hostMemberField?.querySelector("select");

  const syncBookTitleField = () => {
    const show = categorySelect instanceof HTMLSelectElement
      && categorySelect.value === "Book Club meeting";

    if (
      !(bookTitleField instanceof HTMLElement)
      || !(bookTitleSelect instanceof HTMLSelectElement)
      || !(hostMemberField instanceof HTMLElement)
      || !(hostMemberSelect instanceof HTMLSelectElement)
    ) {
      return;
    }

    bookTitleField.hidden = !show;
    bookTitleSelect.disabled = !show;
    hostMemberField.hidden = !show;
    hostMemberSelect.disabled = !show;
    hostMemberSelect.required = show;

    if (!show) {
      bookTitleSelect.value = "";
      hostMemberSelect.value = "";
    }
  };

  syncBookTitleField();
  categorySelect?.addEventListener("change", syncBookTitleField);
</script>

<style>
  .form-card {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
  }

  .form-card h2 {
    font-size: 2rem;
  }

  .forms-lower {
    margin-top: 1.5rem;
  }

  .book-title-field[hidden] {
    display: none;
  }

  .host-member-field[hidden] {
    display: none;
  }

  .trap-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
</style>
