---
const { title = "Get to the Point Book Club" } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A  book club calendar with events, current reading."
    />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #f4efe7;
        --bg-strong: #e6ddcf;
        --card: rgba(255, 250, 244, 0.88);
        --card-strong: #fffaf4;
        --ink: #1f1a17;
        --muted: #665b53;
        --line: rgba(63, 47, 37, 0.14);
        --accent: #8c5a3c;
        --accent-strong: #5d3826;
        --accent-soft: #d7b99c;
        --olive: #64715d;
        --shadow: 0 20px 50px rgba(29, 20, 16, 0.12);
        --radius-xl: 32px;
        --radius-lg: 24px;
        --radius-md: 18px;
        --max: 1180px;
        --font-heading: "Aptos Display", "Segoe UI", "Trebuchet MS", "Helvetica Neue", Arial, sans-serif;
        --font-body: "Aptos", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        font-family: var(--font-body);
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(214, 184, 149, 0.35), transparent 32%),
          linear-gradient(180deg, #f6f1e8 0%, #efe6d7 44%, #f7f2ea 100%);
      }

      body {
        margin: 0;
        min-height: 100vh;
      }

      a {
        color: inherit;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        width: min(calc(100% - 2rem), var(--max));
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(16px);
        background: rgba(246, 241, 232, 0.75);
        border-bottom: 1px solid var(--line);
      }

      .site-header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
      }

      .brand {
        font-size: 1.1rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .nav a,
      .button-link,
      button {
        border: 0;
        border-radius: 999px;
        background: var(--card-strong);
        color: var(--ink);
        text-decoration: none;
        padding: 0.9rem 1.2rem;
        box-shadow: inset 0 0 0 1px var(--line);
        font: inherit;
        cursor: pointer;
        transition:
          background-color 160ms ease,
          color 160ms ease,
          box-shadow 160ms ease,
          transform 160ms ease;
      }

      .nav a:hover,
      .button-link:hover,
      button:hover,
      .nav a:focus-visible,
      .button-link:focus-visible,
      button:focus-visible {
        background: var(--accent-strong);
        color: #fff7f0;
        box-shadow:
          inset 0 0 0 1px rgba(255, 247, 240, 0.14),
          0 8px 20px rgba(93, 56, 38, 0.18);
        transform: translateY(-1px);
      }

      .button-primary {
        background: var(--accent-strong);
        color: #fff7f0;
        box-shadow: none;
      }

      .button-primary:hover,
      .button-primary:focus-visible {
        background: #3f2418;
        color: #fff7f0;
      }

      .section {
        padding: 2.5rem 0;
      }

      .card {
        background: var(--card);
        border: 1px solid rgba(255, 255, 255, 0.42);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow);
      }

      .eyebrow {
        display: inline-block;
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        background: rgba(255, 247, 240, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.45);
        color: var(--accent-strong);
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-heading);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.05;
        margin: 0;
      }

      p {
        margin: 0;
        color: var(--muted);
        line-height: 1.6;
        font-size: 1.05rem;
      }

      .grid-two {
        display: grid;
        gap: 1.5rem;
      }

      .status-banner {
        margin: 1rem 0 0;
        padding: 1rem 1.2rem;
        border-radius: 18px;
        background: rgba(100, 113, 93, 0.12);
        color: #31402d;
        border: 1px solid rgba(100, 113, 93, 0.18);
      }

      .field-grid {
        display: grid;
        gap: 1rem;
      }

      label {
        font-family: var(--font-body);
        display: grid;
        gap: 0.5rem;
        font-size: 0.98rem;
        color: var(--ink);
      }

      input,
      textarea,
      select {
        width: 100%;
        border-radius: 16px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.75);
        padding: 0.95rem 1rem;
        font: inherit;
        color: var(--ink);
      }

      textarea {
        min-height: 7rem;
        resize: vertical;
      }

      .checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .checkbox-row input {
        width: 1.2rem;
        height: 1.2rem;
      }

      .footer {
        padding: 3rem 0 4rem;
        color: var(--muted);
      }

      @media (min-width: 800px) {
        .grid-two {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .field-grid.two {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .field-grid.three {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <div class="brand">Get to the Point Book Club</div>
        <nav class="nav">
          <a href={base}>Home</a>
          <a href={`${base}calendar`}>Calendar</a>
          <a href={`${base}events`}>Upcoming Events</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="footer container">
      Thoughtful reads and  welcoming gatherings.
    </footer>
  </body>
</html>
