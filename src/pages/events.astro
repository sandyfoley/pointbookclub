---
import UpcomingEventsList from "@/components/UpcomingEventsList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getUpcomingEvents } from "@/lib/storage";

const events = await getUpcomingEvents();
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Upcoming Events | Get to the Point Book Club">
  <main class="container section">
    <div class="page-head">
      <div class="eyebrow">Upcoming events</div>
      <h1>Everything coming up next</h1>
      <p>
        A clear chronological list of future gatherings, discussions, and social events.
      </p>
    </div>
    <UpcomingEventsList events={events} />
    <p><a class="button-link" href={`${base}calendar`}>Back to calendar</a></p>
  </main>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .page-head h1 {
    font-size: clamp(2.2rem, 3vw, 3.4rem);
  }
</style>
